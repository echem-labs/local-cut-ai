<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The hardened runtime is required for notarization, and it blocks by
    default exactly what this app needs to do. Each entitlement below is
    present because something concrete fails without it.
  -->

  <!-- The engine is a PyInstaller bundle: it unpacks and executes code that
       was not signed as part of the app. Without these two, Gatekeeper kills
       it on exec and the app sits permanently disconnected. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Python loads native extension modules (onnxruntime, soundfile,
       faster-whisper) from the frozen bundle at runtime. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The shell passes the engine token through the environment, and the
       engine reads LOCALCUT_* config the same way. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Loopback to the local engine, plus BYOK calls to cloud providers and
       weight downloads. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- The remote-engine topology: this machine can also BE the engine. -->
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- Importing a photo or a voice sample, and writing exports out. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
