{
  "name": "localcut-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LocalCut AI desktop shell \u2014 Electron + React frontend for the LocalCut engine",
  "main": "dist-electron/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:5173 && tsc -p electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -p electron && tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron --noEmit",
    "start": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir",
    "package:linux": "npm run build && electron-builder --linux",
    "package:linux:dir": "npm run build && electron-builder --linux --dir"
  },
  "dependencies": {
    "dockview-react": "^7.0.2",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.0.10"
  },
  "author": "Hanzla Mateen <hanzla@lifescope.io>",
  "homepage": "https://github.com/echem-labs/local-cut-ai",
  "desktopName": "localcut-desktop.desktop"
}
