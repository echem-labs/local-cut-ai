# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
# Same shape for agent tooling: the shared settings are tracked, everything
# else an agent CLI writes here is per-developer. settings.local.json holds a
# permission allowlist - absolute home paths, local tool config - and sitting
# untracked beside a tracked settings.json is how it gets committed by a
# `git add .claude`. A secret scanner does not flag a permission list.
.claude/*
!.claude/settings.json

# Env / secrets
.env
.env.*

# Samples
samples/
apps/desktop/scripts/rig/shots/
