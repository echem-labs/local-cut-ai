{
  "checkpoint": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "%%WIDTH%%",
      "height": "%%HEIGHT%%",
      "batch_size": 1
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "%%PROMPT%%",
      "clip": [
        "checkpoint",
        1
      ]
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, low quality, deformed, watermark, text, logo, oversaturated",
      "clip": [
        "checkpoint",
        1
      ]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "%%SEED%%",
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": [
        "checkpoint",
        0
      ],
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "checkpoint",
        2
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "localcut_thumbnail",
      "images": [
        "decode",
        0
      ]
    }
  }
}